<h2><%= @flat.name %></h2>
<p><%= @flat.address %></p>
<p><%= @flat.description %></p>
<p><%= @flat.number_of_guests %> guests · <%= @flat.price_per_night %> €</p>
<%= link_to "Edit", edit_flat_path(@flat), class: "btn btn-outline-primary btn-sm" %>
<%= link_to "Delete", flat_path(@flat), class: "btn btn-outline-danger btn-sm",
      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
<%= link_to "Back", flats_path %>
