<h2 class="my-3">All our Flats (<%= @flats.count %>)</h2>
<div class="row">
  <%= link_to "New flat", new_flat_path, class: "btn btn-outline-primary btn-sm" %>
  <% @flats.each do |flat| %>
    <div class="col-12 col-md-4 mb-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title"><%= flat.name %></h5>
          <p class="card-text small"><%= flat.address %></p>
          <i class="fa-solid fa-user-group"></i> <%= flat.number_of_guests %>
          <i class="fa-solid fa-euro-sign ms-3"></i> <%= flat.price_per_night %>
        </div>
        <div class="card-footer bg-white">
          <%= link_to "More info", flat_path(flat) %>
          <%= link_to "Edit", edit_flat_path(flat), class: "ms-2 text-success" %>
          <%= link_to "Delete", flat_path(flat), class: "ms-2 text-danger",
        data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
        </div>
      </div>
    </div>
  <% end %>
</div>
